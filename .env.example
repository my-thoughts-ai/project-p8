# Copy to .env and fill in. NEVER commit .env.
# Every value is optional — a channel simply stays disabled without its secrets.

# --- Where alerts are delivered ---
# Kept out of config.yaml so the repository can be public with no personal data in it.
# MANASLU_EMAIL_TO may be left blank: the digest then goes to GMAIL_ADDRESS (yourself).
MANASLU_EMAIL_TO=
MANASLU_SMS_TO=

# --- Email (Gmail SMTP + App Password, not your normal password) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Telegram (free; talk to @BotFather, then @userinfobot for the chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twilio SMS (billed per 160-char segment; ~EUR 0.075/segment to +49) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
